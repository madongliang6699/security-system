# MySQL 5.7.36 配置文件 (my.cnf)

# 说明：本配置文件是通过ChatGPT和网上文章，汇总的mysql参数配置，这里的绝大多数的参数的值应该是一个比较常用的值，当然不排除在特定的硬件配置下不适用。
# 这里的参数设置没有全部验证过，应该没有什么语法或字符错误问题。
# 这里的一部分参数可能并不需要配置，因为默认值就挺好。不过有些参数是一定要配置的，比如编码和排序规则，还有大小写不敏感，某些最大值的参数。
# 这里总结的基本上都是基于mysql5.7版本，其他版本特别是8以上的版本，这里的个别参数可能不适用。

# ==============================================================================================

# [client]下面是客户端参数设置，定义所有 MySQL 客户端工具的默认连接设置，如主机、端口、字符集等。所有使用MySQL客户端工具（如 mysql、mysqldump 等）时，都会参考这些设置。
[client]
# 默认连接的主机地址
host = localhost
# 默认连接的端口
port = 3306
# 默认连接的用户
user = root
# 默认使用的字符集
default-character-set = utf8mb4



# ==============================================================================================


# [mysqld]下面的是MySQL服务器设置，定义 MySQL 服务器守护进程的配置，涵盖数据库存储路径、网络设置、字符集、日志、缓存、性能调优等各方面的配置。这部分是影响 MySQL 服务器性能和行为的核心配置。
[mysqld]
# 数据库数据文件存放的路径
datadir = /var/lib/mysql
# 服务器监听的端口号
port = 3306
# 使用的 socket 文件路径（用于本地连接）
#socket = /var/run/mysqld/mysqld.sock
socket=/var/lib/mysql/mysql.sock
# 服务的主机IP地址（默认监听所有接口）
bind-address = 0.0.0.0

# innodb_file_per_table参数是MySQL中InnoDB存储引擎的一个关键配置选项，它决定了每个新创建的表的数据及索引是存储在独立的.ibd文件中，
# 还是存储在共享的表空间中。‌当innodb_file_per_table参数设置为OFF时，每个表只生成.frm表结构定义的描述文件，数据存储在共享的ibdata1文件中.
# ‌当innodb_file_per_table参数设置为ON时，每个新创建的表的数据及索引将存储在一个独立的.ibd文件中，即每个表会生成两个文件：.frm（表结构文件）和.ibd（表数据和索引文件）。
# 这种情况下，每个表都有其独立的表空间，这带来了几个优点：
# 第一是每个表都有自己独立的表空间，便于管理和移动单个表。
# 第二是可以实现单表空间回收，即通过删除表DROP TABLE或更改表引擎的方式ALTER TABLE ... ENGINE=InnoDB来回收不再使用的空间。
# 第三是对于大量删除操作的数据表，独立表空间能够更好地管理碎片，减少性能影响。
# 当innodb_file_per_table参数设置为OFF时‌，所有表的数据及索引将存储在共享的表空间中，通常是一个名为ibdata1的文件。
# 这种配置的优点在于简化管理，因为所有表共享同一个表空间文件，但缺点是当大量删除操作后，共享表空间中可能会留下大量的空隙，
# 这些空隙在统计分析或日志系统中可能造成问题。
# 不同的版本默认值不一样， 目前安装的5.7.36是默认是ON。 通过新建一个测试表，可以看出有没有单独的.idb文件。
#innodb_file_per_table=1

# MySQL 服务器的基本配置
# sql_mode是启动时默认的可以允许的SQL编写模式（如严格模式），如ONLY_FULL_GROUP_BY：SELECT中的列必须在GROUP BY中出现，NO_ZERO_DATE：插入是零的日期会抛出错误而不是警告。
# 下面是默认值
# sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
# 最大允许的客户端连接数
max_connections = 200
# 针对某一个账号的所有客户端并行连接到MYSQL服务的最大并行连接数,设置为0表示不限制。
max_user_connections = 100
# 用于设置密码的过期天数。它规定了用户密码在多少天后需要更新。如果设置为非零值，用户密码在指定的天数后将过期，并要求用户更改密码。默认0不会过期。
default_password_lifetime = 0

# 避免警告
explicit_defaults_for_timestamp = 1

# 设置mysql对表名和库名大小写不敏感，新建的表名会转换成小写存储。Linux系统，该参数默认值是一般时0，即大小写敏感。
# 【特别注意，这个参数绝对不能随便改】这个参数应该在刚安装好mysql服务时就设置好，否则中途修改成1的话会很麻烦，可能需要先导出数据，把表名事先都改成小写，
# 然后再设置成1重启服务，然后再导入数据，否则表和数据可能看不到了。
# 为了避免大小写引发的问题，一种推荐的命名规则是：在定义数据库、表、列的时候全部采用小写字母加下划线的方式，
# 不使用任何大写字母，在任何系统中可以使用lower_case_table_names=1。
# 使用该选项的不利之处是当使用SHOW TABLES或SHOW DATABASES时，看不出名字原来是用大写还是小写。
# 字段名都是大小写不敏感的，不用担心这个问题。
# 字段的数据，字段值的大小写由mysql的校对规则来控制。提到校对规则，就不得不说字符集。字符集是一套符号和编码，校对规则是在字符集内用于比较字符的一套规则.
# 一般而言，校对规则以其相关的字符集名开始，通常包括一个语言名，并且以_ci（大小写不敏感）、_cs（大小写敏感）或_bin（二元）结束 。
# 比如 utf8字符集，utf8_general_ci,表示不区分大小写，这个是utf8字符集默认的校对规则；utf8_general_cs表示区分大小写，utf8_bin表示二进制比较，同样也区分大小写 。
lower_case_table_names=1

# 字符集与排序规则设置
# 服务器字符集，默认的是latin1字符集，新增汉字都会报错。修改成utf8mb4为默认的，以后建库、建表、建字段都是默认这个。
# 在 MySQL 中，utf8mb4 是比 utf8 更加推荐使用的字符集，尤其是在现代应用场景中。
# 下面是对这两个字符集的对比和推荐使用的原因：utf8：MySQL 的 utf8 实际上并不是完全的 UTF-8 编码。
# 它只能支持最多 3 个字节的字符编码，意味着它能够表示的字符范围有限，大约能覆盖 Unicode 的前 65536 个代码点（即基本多文种平面，BMP）。
# 因为 utf8 不能处理 4 字节的 Unicode 字符，这意味着一些常见的字符（例如表情符号、部分罕见的汉字或历史文字）无法被正确存储，
# 会导致数据插入失败或字符丢失。而utf8mb4 是 MySQL 中真正完整的 UTF-8 编码，能够支持最多 4 个字节的字符编码，utf8mb4 是向后兼容 utf8的，
# 意味着它可以表示所有的 Unicode 字符，包括 BMP 之外的字符。这种字符集适用于需要支持表情符号（emoji）、较少使用的汉字、以及其他非基本多文种平面字符的情况。
character-set-server = utf8mb4
# 设置默认的服务器排序规则，在 MySQL 中，选择适当的排序规则（collation）对于处理字符串的排序和比较至关重要。
# utf8mb4_unicode_ci、utf8mb4_general_ci、 utf8mb4_general_cs 和 utf8mb4_bin 是常用的几种排序规则，它们在性能、准确性和用途上各有不同。
# 首先_ci结尾是不区分大小写的，_cs是区分大小写的，utf8mb4_bin是一种二进制排序规则，它将字符按其二进制值进行排序和比较，也是精准区分大小写的。
# utf8mb4_unicode_ci基于 Unicode 标准的排序规则，支持更广泛和精确的多语言比较。它遵循 Unicode Collation Algorithm (UCA)，确保字符在国际化环境中得到一致的排序和比较结果。就是对一些特定国家的特定文字都很精准，缺点是比utf8mb4_general_ci速度慢一些。
# utf8mb4_general_ci是一个性能优化的排序规则，速度比较快一些，较早的版本被设计为通用用途。虽然它能处理大部分情况下的字符比较，但在某些语言或特殊字符的排序上不如 utf8mb4_unicode_ci 精确。例如某些国家语言中的变音符号可能被忽略。但是平时我们使用肯定够用了。
# utf8mb4_bin是一种二进制排序规则，它将字符按其二进制值进行排序和比较。这意味着排序和比较时区分大小写和字符的精确二进制表示。因为直接基于二进制值进行比较，性能通常比其他两种排序规则更高。比较完全基于字符的二进制值，不进行任何语言学意义上的转换或忽略。
# 在实际开发中，utf8mb4_bin比较严格，即区分大小写，还严格进行非常相近的符号做区分（比如同一个字符的加重音和不加重音），排序结果与字符的二进制编码有关的排序规则，这在实际生活中的模糊查询上比较严格，可能查询不到想要的结果。
# 因此，使用utf8mb4_unicode_ci和utf8mb4_general_ci更好。所以如果系统没有特殊表情符号和语言文字的需求，可以使用utf8mb4_general_ci，否则使用utf8mb4_unicode_ci更安全更有扩展性。
# 补充：比较新版的mysql已经默认使用utf8mb4编码和utf8mb4_0900_ai_ci排序规则，utf8mb4_0900_ai_ci是utf8mb4_unicode_ci的一种，_ai代表不分区一个字符的重音符号（“á”和“a”）
collation-server = utf8mb4_unicode_ci

# 缓冲区与缓存设置
# InnoDB 的缓冲池大小，缓冲池用于缓存数据页、索引页和 InnoDB 表的其它信息。增大 InnoDB 缓冲池大小，提高缓存命中率。并不是越大越好。innodb_buffer_pool_size 应该设置要尽可能大，但要确保为操作系统和其他应用程序留出足够的内存。一般建议在数据库专用服务器上设置为物理内存的 60% 到 80%。通过监控数据库性能和内存使用情况，可以进一步调整这个参数以优化数据库性能。
innodb_buffer_pool_size = 1G
# InnoDB 的日志文件大小，增大日志文件大小，减少日志文件切换的开销。
innodb_log_file_size = 256M
# InnoDB 的日志缓冲区大小
innodb_log_buffer_size = 64M
# 表示打开文件的最大数量
open_files_limit = 65535
# 表示线程缓存的大小，增大线程缓存大小，减少线程创建开销。
thread_cache_size = 128
# join_buffer_size是MySQL数据库中的一个关键参数，主要用于处理JOIN操作，特别是当JOIN操作没有使用索引时。‌
# 这个参数通过为JOIN操作提供缓冲区，旨在减少表扫描次数，从而提高查询效率。
# 具体来说，join_buffer_size的作用范围和设置建议如下：‌作用范围‌：join_buffer_size主要影响无索引的JOIN操作，
# 通过块嵌套循环连接（Block Nested-Loop Join）的方式工作，以减少表扫描次数，提高查询效率。
# 它为每个JOIN操作分配缓冲区，这些缓冲区用于缓存SQL语句查询涉及到的字段数据，而不会缓存多余的数据。
# 因此，对于JOIN操作的优化，需要根据最大连接数和服务器可用内存来合理分配join_buffer_size的值，
# 以防止内存用尽或发生OOM（Out of Memory）错误。
# 一般而言，4-8M是一个比较合理的值（默认值是256k），但对于复杂的连接SQL，可以在SQL语句中通过hint方式或在session级别临时增大该值以优化特定查询‌
join_buffer_size=8m
# 参数在MySQL中是常用的。‌这个参数用于指定MySQL在执行随机读取操作时使用的缓存大小。
# 当MySQL执行需要随机读取数据的查询语句时，read_rnd_buffer_size参数指定了MySQL用于读取数据的内存缓存大小，从而提高随机读取操作的效率
read_rnd_buffer_size=8M

# 查询缓存设置
# 启用查询缓存
query_cache_type = 1
# 查询缓存的大小，用于指定查询缓存的大小。查询缓存可以缓存 SELECT 查询的结果，避免重复执行相同的查询，从而提高性能。
query_cache_size = 64M

# 日志设置
# 二进制日志的文件路径和文件名
log-bin = /var/log/mysql/mysql-bin.log
# 启用慢查询日志
slow_query_log = 1
# 慢查询日志的存储路径
slow_query_log_file = /var/log/mysql/mysql-slow.log
# 定义慢查询的阈值（超过该时间的查询会被记录）
long_query_time = 2

# 复制设置（用于主从复制）
# 设置 server_id，主从服务器应有不同的 ID
server-id = 1
# log-bin 和 log_bin参数：用于在主服务器和从服务器上启用二进制日志功能。
# 二进制日志记录了对数据库进行的所有更改数据的操作（如 INSERT、UPDATE、DELETE）。
# 这些日志文件是主从复制的基础，因为从服务器通过读取主服务器的二进制日志来获取要执行的操作。
#log-bin 可用于指定二进制日志文件的存储路径和前缀。log_bin是log-bin 的一种替代写法，仅用于启用或禁用二进制日志功能，通常没有附带路径和前缀信息（log_bin = 1）。
#适用范围：可以在主服务器开启这个配置，这是主从复制的前提，但是也可以摘从服务器上启用二进制日志，在从服务器上启用二进制日志是为了实现链式复制（即该从服务器同时作为另一个从服务器的主服务器）。
log-bin = /var/log/mysql/mysql-bin  # 将二进制日志存储在指定目录，并以 'mysql-bin' 为前缀命名。
# 指定从服务器的中继日志文件的路径和前缀。用于从服务器上启用中继日志功能。中继日志是从服务器用于存储从主服务器接收的二进制日志的副本。中继日志是从服务器执行操作的来源。从服务器的 SQL 线程会从中继日志中读取命令并执行它们，确保从服务器的数据与主服务器保持同步，即主从复制功能。
relay-log = /var/log/mysql/mysql-relay-bin
#以下为可选配置
# 二进制日志的保留天数，自动清理过期的二进制日志，默认0不过期
expire_logs_days = 10
#日志大小
max_binlog_size=1000m
#缓存大小
binlog_cache_size=4m
#最大缓存大小
max_binlog_cache_size=521m


# 安全设置
# 禁止使用 LOAD DATA LOCAL INFILE 命令
local_infile = 0

# 错误日志文件路径
#log-error = /var/log/mysql/mysql-error.log
log-error=/var/log/error.log
pid-file=/var/run/mysqld/mysqld.pid

# MySQL 服务的资源限制
# 最大允许的表连接数的缓存，当某一连接访问一个表时，MySQL会检查当前已缓存表的数量。如果该表已经在缓存中打开，则会直接访问缓存中的表已加快查询速度；如果该表未被缓存，则会将当前的表添加进缓存并进行查询。在执行缓存操作之前，table_cache用于限制缓存表的最大数目：如果当前已经缓存的表未达到table_cache，则会将新表添加进来；若已经达到此值，MySQL将根据缓存表的最后查询时间、查询率等规则释放之前的缓存。
table_open_cache = 4096
# 增大临时表和堆表的最大大小，减少磁盘 I/O。
tmp_table_size = 64M
max_heap_table_size = 64M
# MySQL 服务器使用的堆栈大小
thread_stack = 256K
# MySQL服务器和客户端之间通信的最大数据包大小（默认单位是字节，命令行设置的话只能用字节单位），这个参数的设置对于处理大数据量的传输非常重要，默认好像是4M，可以修改成16M或更大。
max_allowed_packet=16M

# MyISAM 存储引擎设置
# MyISAM 索引文件的缓存大小
key_buffer_size = 256M
# 读缓冲区的大小
read_buffer_size = 8M
# 排序缓冲区的大小
sort_buffer_size = 8M

# 复制配置 (主从复制相关)
# 复制过滤器，仅同步指定的数据库
replicate-do-db = example_db
# 忽略指定数据库的复制
replicate-ignore-db = ignore_db

# 安全性与访问控制设置
# 允许的最大连接错误数:针对某一个IP主机连接不成功(如密码错误)与mysql服务连接的次数，如果超过这个值，这个IP主机将会阻止从这个IP主机发送出去的连接请求。如果已经阻止某ip，需执行flush hosts。
max_connect_errors = 100
# 禁用符号链接（更安全）
symbolic-links = 0

# 缓存设置
# 表示临时表的最大大小
tmp_table_size = 64M
# 表示缓存内存的大小
query_cache_size = 64M

# 性能优化设置
# 启用并行复制（可以提高从库的复制性能）
slave_parallel_workers = 4
# 启用 InnoDB 自动分区加载（减少启动时间）
innodb_autoinc_lock_mode = 2

# 优化日志文件的回收策略
log-bin-trust-function-creators = 1
# 根据需求调整日志刷新策略，权衡性能和数据安全性。
innodb_flush_log_at_trx_commit = 2

# 启动时禁用性能模式
performance_schema = 0


# ==============================================================================================

# [mysql]下面的是MySQL客户端设置，定义 MySQL 命令行客户端工具的配置，如字符集、提示符等。仅影响命令行工具 mysql 的行为。
[mysql]
# 设置命令行客户端使用的字符集
default-character-set = utf8mb4
# 禁用启动时的蜂鸣音
no-beep
# 自定义命令行提示符，和Linux命令行提示符差不多
prompt = (\u@\h) [\d]>




# ==============================================================================================


# [mysqladmin]下面的是MySQL管理工具设置，定义 mysqladmin 管理工具的配置，如字符集等。这个部分是专门针对 mysqladmin 工具的。
[mysqladmin]
# 默认使用的字符集
default-character-set = utf8mb4
