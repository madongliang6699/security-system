<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.security</groupId>
        <artifactId>security-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>security-order</artifactId>
    <version>1.0.0-SNAPSHOT</version>


    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>


    <dependencies>

        <dependency>
            <groupId>com.security</groupId>
            <artifactId>rate-limiter-starter</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.security</groupId>
            <artifactId>security-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.security</groupId>
            <artifactId>security-service-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <version>2.6</version>
        </dependency>

        <dependency>
            <groupId>org.squirrelframework</groupId>
            <artifactId>squirrel-foundation</artifactId>
            <version>0.3.8</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
        </dependency>

        <!-- 引入seata整合分布式事务 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
            <exclusions>
                <exclusion>
                    <!--  这里排除是因为自动加入的版本可能与安装的seata的TC服务版本不一致，下面手动导入版本一致的-->
                    <groupId>io.seata</groupId>
                    <artifactId>seata-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 跟安装的seata-server需要保持版本一致 -->
        <dependency>
            <groupId>io.seata</groupId>
            <artifactId>seata-spring-boot-starter</artifactId>
            <version>1.3.0</version>
        </dependency>
    </dependencies>


    <build>

        <!-- <resources>标签的作用就是指定编译的时候把哪些文件(src/main/resources下的文件和src/main/java的文件)复制(或者说打包)到项目target目录下的哪个目录位置,
        而文件存放在哪个目录位置就决定了打项目jar包后该文件所在jar包中的位置, maven的package命令的作用是把编译后的target目录下的classes目录打成jar包放在target目录下,因此,
        如果这里配置成把相关文件复制到classes文件的外面,那打jar包的时候就不会打进jar包了.

        如果这里配置没有把相关资源配置文件打进jar包中,
        那启动的时候可能会报错,
        因为缺少springboot的properties配置文件或mybatis的xml文件等文件,
        但是如果把spring的properties配置文件也打进jar包,在线上运行的时候就没法随时改properties文件的配置了,配置文件就失去了意义.
         因此,常用的做法应该是把特定的文件(xml或sql或doc或ft等)打包进jar包,properties配置文件打包在jar包外面,这样就可以随时修改配置了.
         而<resources>标签默认会把资源文件复制到classes目录内部,进而打包的时候就打到jar包里面了. 因此就要用到<resources>内的<targetPath>标签,指定资源文件存放的位置,
         进而决定配置文件在不到jar包内部.
         具体看下面的配置
          -->
        <resources>
            <resource>
                <!-- 指定src/main/resources下的哪些文件打包到哪个位置,如果不配置默认把src/main/resources下的所有文件复制到target/classes目录下 -->
                <directory>src/main/resources</directory>
                <includes>
                    <!-- 指定只复制resources文件夹下的properties配置文件 -->
                    <include>**/*.properties</include>
                </includes>
                <!-- 指定资源配置文件复制到${project.build.directory}目录(就是target目录,和jar包同级的目录), 而不是classes目录,这样打包后配置文件才会打到jar包外部.
                不指定targetPath的话, 所有资源配置文件默认复制到target/classes目录下,也就打包把资源文件打到jar包里面了.
                虽然配置文件在jar包外部, 在java -jar myApp.jar 启动程序的时候,会默认找当前目录(执行java -jar命令的目录)下的配置文件的.  -->
                <targetPath>${project.build.directory}</targetPath>
                <!-- 指定是否开启替换标签，若文件中有类似${key}这样的配置，就会根据maven的pom中profiles配置的变量值进行覆盖，true表示开启替换，默认为false, 一般应该用不到这个功能 -->
                <filtering>true</filtering>
            </resource>
            <resource>
                <!-- 上面这个<resource>标签的作用是控制把.properties文件复制到target目录下,达到配置文件打包到jar外面的效果,
                但是复制到target后classes目录下就没有properties配置文件了, 在本地idea中启动项目的的时候就可能报错,因为idea启动默认是在classes目录下找配置文件(因为找不到配置文件,
                在没有配置文件的情况下启动,所有组件(比如Redis的自动装配,mybatis-plus的自动装配等)就使用其默认的配置参数,服务的端口就使用默认的8080),
                所以当前这个<resource>标签是再次指定一下所有文件都需要复制到classes目录下.
                 -->
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
            <resource>
                <!-- 指定src/main/java下的哪些文件复制到哪个位置,如果不配置默认只把src/main/java下对应的的所有.class文件复制到target/classes目录下 -->
                <directory>src/main/java</directory>
                <includes>
                    <!-- 指定把java文件夹下的properties配置文件 和 xml文件等文件复制到classes目录下,进而能打进jar包中,
                    这里最好不要配置成 <include>**/*</include>, 因为这样会把.java文件和临时文件都打包进去
                     -->
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.ftl</include>
                    <include>**/*.doc</include>
                    <include>**/*.docx</include>
                </includes>
            </resource>
            <resource>
                <directory>dockerfile</directory>
                <includes>
                    <include>Dockerfile</include>
                </includes>
                <targetPath>${project.build.directory}</targetPath>
                <filtering>true</filtering>
            </resource>
        </resources>


        <plugins>
            <!-- spring-boot-maven-plugin 插件是专门给springboot项目打fat jar包的，就是把所有依赖的jar包和类加载的依赖包，都一并打成一个jar包，形成一个可直接执行的jar包。注意，可执行jar包就不能当作普通jar包被其他项目包依赖了。-->
            <!--   需要知道的是，打fat jar包的插件还有其他插件，比如 maven-jar-plugin 插件， 而spring-boot-maven-plugin插件是专门给springboot打fat jar包的。       -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>2.3.2.RELEASE</version>
                <!-- <configuration>-->
                <!--    <includeSystemScope>true</includeSystemScope>-->
                <!--    <fork>true</fork>-->
                <!-- </configuration>-->
                <executions>
                    <execution>
                        <goals>
                            <!--  插件的这个”目标“的作用是“再打包”：我们知道默认打的jar包只有我们自己的代码，而spring-boot-maven-plugin插件配置了repackage目标后，就会再次打包，就是打成上面说的可执行的jar包。因此这个repackage配置不能少。
                                配置repackage后，打包的时候会把默认打的xxx.jar包改成xxx.jar.original的一个文件作为无用备份，再次打出一个xxx.jar的可执行jar包。
                                在target文件夹中可以看到这两个文件。这样打出的fat jar包内部，BOOT-INF目录下有两个子目录：classes和lib目录。lib目录存放的是应用依赖的jar包，
                                classes目录下存放的是项目CLASS_PATH下的内容，包括应用代码和配置文件（比如application.yml等），可以理解为repackage将原始Maven打包的jar文件中的除META-INF以外的内容放置到该目录下打包。
                                并且MANIFEST.MF文件中有指明main方法的启动类，但是可执行的jar包不能作为普通jar包依赖引入，引入这样的jar会报错找不到类。报错：com.oceansite.system.config.ShipImoConfig。
                                打包插件版本应该和springboot版本一致，否则会报版本报错。如果子模块有引入其他模块。直接子模块打包会报错找不到这个依赖（因为会从仓库里去找），需要整个项目一起打包，才能打成功。-->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.0.2</version>
                <configuration>
                    <excludes>
                        <!-- 因上面需要有两个<resource>标签的缘故, 导致目前classes目录的内外都有properties配置文件,而打出的jar包我们只想要外部的配置文件,
                        因此这里使用 maven-jar-plugin插件 把默认的内部的properties配置文件在打包的时候排除掉(没法直接使用spring-boot-maven-plugin插件排除)-->
                        <exclude>**/*.properties</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- maven-source-plugin 插件的作用是打包的时候同时打出一个源码包，比如：security-order-1.0.0-SNAPSHOT-sources.jar，把源码包也上传到私服，这样其他同事查看你代码的时候，可以下载源码查看注释-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.0.1</version>
                <executions>
                    <execution>
                        <!-- 该"目标"的作用是把源码也打成jar包,有源码包之后就可以上传到私服供别人下载查看了 -->
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>attach-test-sources</id>
                        <goals>
                            <!-- 把测试用例代码也打进jar包 -->
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>


    </build>


</project>