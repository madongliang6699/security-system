<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.security.inventory.mapper.InventoryMapper">


    <select id="selectStockForUpdate" resultType="com.security.inventory.model.entity.ProductStockDO">
        select *
        from inventory_product_stock
        where id = #{id}
        for update
    </select>


</mapper>
