    <select id="selectByKeyWord" resultMap="BaseResultMap"
            parameterType="com.cybstar.base.secureBase.solidWaste.hazardousWaste.dto.HseReceiveUnitBaseDTO">
        select
        sid,
        app_id,
        name,
        address,
        administrative_division_id,
        administrative_division_name,
        linkman,
        contact_number,
        license_number,
        file_id,
        remark,
        update_by,
        update_time,
        create_by,
        create_time,
        tenant_id,
        tenant_name,
        del_flag

        from hse_receive_unit_base
        where app_id = #{appId} and del_flag=0

        <if test="keyWord != null and keyWord != ''">
            and (
            name like concat('%',#{keyWord},'%')
            or address like concat('%',#{keyWord},'%')
            or linkman like concat('%',#{keyWord},'%')
            or contact_number like concat('%',#{keyWord},'%')

            )
        </if>


